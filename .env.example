RAG_MODE=real
# Unified platform configuration. Copy to .env; never commit .env.
# Leave LLM_API_KEY empty for mock startup.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
MINERU_API_TOKEN=
MINERU_BASE_URL=
REQUEST_TIMEOUT_SECONDS=120

# Text-to-SQL infrastructure. These values are consumed by the sibling
# service through PLATFORM_ENV_FILE when START_PLATFORM.bat launches it.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=change-me-local
MYSQL_META_DATABASE=meta
MYSQL_DW_DATABASE=dw
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ES_INDEX_NAME=data_agent
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081
EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
BGE_M3=BAAI/bge-m3
BGE_M3_PATH=
BGE_DEVICE=cpu
BGE_FP16=0
BGE_DIMENSION=1024
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# Release repositories; SETUP uses sibling directories by default. The public
# repository URLs and fixed tags are maintained centrally in
# scripts/release_config.ps1, not in the user's daily .env.
RAG_REPO_DIR=../rag-knowledge-agent
WSHU_REPO_DIR=../text2sql-data-agent

# Service URLs.
ZHIKU_BASE_URL=http://127.0.0.1:8010
WSHU_BASE_URL=http://127.0.0.1:8001
VITE_GATEWAY_BASE_URL=http://127.0.0.1:9010
