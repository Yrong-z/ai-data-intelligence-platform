RAG_MODE=demo
# Unified platform configuration. Copy to .env; never commit .env.
# Leave LLM_API_KEY empty for mock startup.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
MINERU_API_TOKEN=

# Release repositories; defaults assume three sibling directories.
RAG_REPO_DIR=../rag-knowledge-agent
WSHU_REPO_DIR=../text2sql-data-agent

# Service URLs.
ZHIKU_BASE_URL=http://127.0.0.1:8010
WSHU_BASE_URL=http://127.0.0.1:8001
VITE_GATEWAY_BASE_URL=http://127.0.0.1:9010
